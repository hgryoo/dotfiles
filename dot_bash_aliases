# CUBRID environment switcher
# Usage: use-cubrid [root_dir] [install_subdir]
#   root_dir      — root of the CUBRID source tree  (default: ~/cubrid)
#   install_subdir — install directory name inside root  (default: install.out)
# Examples:
#   use-cubrid                          → ~/cubrid/install.out
#   use-cubrid ~/cubrid-12              → ~/cubrid-12/install.out
#   use-cubrid ~/cubrid-12 build.out    → ~/cubrid-12/build.out
# Safe to call multiple times — strips previous CUBRID entries before setting new ones.
use-cubrid() {
  local cubrid_root="${1:-$HOME/cubrid}"
  local install_subdir="${2:-install.out}"
  local cubrid_path="$cubrid_root/$install_subdir"

  if [ ! -d "$cubrid_path" ]; then
    echo "Error: CUBRID install dir does not exist: $cubrid_path" >&2
    return 1
  fi

  # Strip any existing CUBRID entries from PATH and LD_LIBRARY_PATH
  # to prevent accumulation when switching between versions.
  # Uses -F (fixed-string) to avoid regex metacharacter issues in paths.
  if [ -n "${CUBRID:-}" ]; then
    PATH=$(echo "$PATH" | tr ':' '\n' | grep -Fv "$CUBRID" | paste -sd ':' || true)
    LD_LIBRARY_PATH=$(echo "${LD_LIBRARY_PATH:-}" | tr ':' '\n' | grep -Fv "$CUBRID" | paste -sd ':' || true)
    # Ensure we don't end up with an empty PATH which would expose CWD
    PATH="${PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}"
  fi

  export CUBRID="$cubrid_path"
  export CUBRID_DATABASES="$CUBRID/databases"
  export LD_LIBRARY_PATH="$CUBRID/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  export PATH="$CUBRID/bin:$PATH"
  echo "CUBRID environment set to: $CUBRID"
}

# --- Claude Code 계정 프로필 전환 (added 2026-06-01, tmux 래핑 복원 2026-06-18) ---
# 기본 계정(개인): ~/.claude (hyunggyu.ryoo@gmail.com)
# cubrid 계정(회사): ~/.claude-cubrid (hgryoo@cubrid.com)
#
# claude-main / claude-cubrid 는 tmux 없이 직접 실행하는 탈출구(raw)로 남겨둔다.
alias claude-main='CLAUDE_CONFIG_DIR=$HOME/.claude command claude'
alias claude-cubrid='CLAUDE_CONFIG_DIR=$HOME/.claude-cubrid command claude'

# 공통: Claude Code 를 tmux 세션 안에서 실행하는 래퍼.
#   _claude_run <config_dir> [claude 인자...]
# - 이미 tmux 안($TMUX)이거나 stdout 이 TTY 가 아니면(파이프/비대화형) in-place 실행.
# - 아니면 현재 경로 마지막 2개 컴포넌트로 이름 붙인 새 tmux 세션을 띄운다.
_claude_run() {
  local config_dir="$1"; shift
  if [ -n "$TMUX" ] || [ ! -t 1 ]; then
    CLAUDE_CONFIG_DIR="$config_dir" command claude "$@"
    return $?
  fi
  # tmux 세션 이름엔 '.' ':' 불가 → 마지막 2개 경로 컴포넌트를 슬러그화.
  local dir_tail dir_slug
  dir_tail=$(printf %s "$PWD" | awk -F/ '{n=NF; a=(n>1?$(n-1):""); b=$n; print (a==""?b:a"-"b)}')
  dir_slug=$(printf %s "$dir_tail" | tr -c '[:alnum:]_-' '-' | sed 's/-\{2,\}/-/g; s/^-//; s/-$//')
  [ -z "$dir_slug" ] && dir_slug="root"
  # 세션 이름 접두사로 계정 구분: ~/.claude → claude- (cl), ~/.claude-cubrid → claudec- (clc).
  # cl-tabs / clc-tabs 가 이 접두사로 계정별 세션을 골라낸다.
  local prefix=claude
  [ "$(basename -- "$config_dir")" = ".claude-cubrid" ] && prefix=claudec
  local session="${prefix}-${dir_slug}-$$"
  local args
  args=$(printf '%q ' "$@")
  tmux new-session -s "$session" "CLAUDE_CONFIG_DIR=$(printf %q "$config_dir") command claude $args"
}

# 짧은 진입점: cl → 개인 계정, clc → 회사(cubrid) 계정 (둘 다 tmux 세션 안에서 실행).
cl()  { _claude_run "$HOME/.claude"        --dangerously-skip-permissions --effort xhigh "$@"; }
clc() { _claude_run "$HOME/.claude-cubrid" --dangerously-skip-permissions --effort xhigh "$@"; }
clt() { _claude_run "$HOME/.cubrid-cubrid1" --dangerously-skip-permissions --effort xhigh "$@"; }

# `claude` 만 입력하면 개인(cl) / 회사(clc) 중 선택하도록 묻고, 역시 tmux 세션 안에서 실행.
# 프롬프트 없이 바로 쓰려면 cl / clc 를 사용.
claude() {
  local sel
  echo "어떤 Claude 계정으로 실행할까요?" >&2
  echo "  1) cl  → 개인 계정 (hyunggyu.ryoo@gmail.com)  [~/.claude]" >&2
  echo "  2) clc → 회사 계정 (hgryoo@cubrid.com)        [~/.claude-cubrid]" >&2
  read -r -p "선택 [1/2] (기본 1): " sel
  case "$sel" in
    2|clc|c) _claude_run "$HOME/.claude-cubrid" "$@" ;;
    *)       _claude_run "$HOME/.claude"        "$@" ;;
  esac
}

# --- nvim + Claude 를 한 화면에 (added 2026-09-21) ---
# vcl / vclc / vclt : cl / clc / clt 와 같은 계정으로, 현재 경로에서 nvim(왼쪽)과
# claude(오른쪽)를 한 tmux 창의 두 pane 으로 띄운다. 인자는 claude 로 넘어간다.
#
# 핵심은 두 pane 이 서로 붙는다는 것이다. claudecode.nvim 은
# $CLAUDE_CONFIG_DIR/ide/<port>.lock 에 락을 쓰므로, nvim 에도 같은 계정을 주고
# 새로 생긴 락에서 포트를 읽어 claude 쪽에 CLAUDE_CODE_SSE_PORT 로 넘긴다.
# --ide 만 쓰면 "정확히 하나"일 때만 자동 연결이라, 에디터를 여러 개 띄워 두면 실패한다.
#
# 세션 이름은 _claude_run 과 같은 규칙(claude- / claudec-)이라 cl-tabs / clc-tabs 가
# 이 세션들도 그대로 모아 준다.
_claude_nvim_run() {
  local config_dir="$1"; shift
  command -v tmux >/dev/null || { echo "tmux 가 필요합니다" >&2; return 1; }

  local qcd qargs
  qcd=$(printf %q "$config_dir")
  qargs=$(printf '%q ' "$@")

  # 이 nvim 이 새로 만드는 락만 골라내기 위해 먼저 스냅샷.
  local before=" "
  local f
  for f in "$config_dir"/ide/*.lock; do [ -e "$f" ] && before="$before$f "; done

  # 세션/창 이름: 마지막 2개 경로 컴포넌트 슬러그 (_claude_run 과 같은 규칙).
  local dir_tail dir_slug prefix session pane
  dir_tail=$(printf %s "$PWD" | awk -F/ '{n=NF; a=(n>1?$(n-1):""); b=$n; print (a==""?b:a"-"b)}')
  dir_slug=$(printf %s "$dir_tail" | tr -c '[:alnum:]_-' '-' | sed 's/-\{2,\}/-/g; s/^-//; s/-$//')
  [ -z "$dir_slug" ] && dir_slug="root"
  prefix=claude
  [ "$(basename -- "$config_dir")" = ".claude-cubrid" ] && prefix=claudec
  session="${prefix}-${dir_slug}-$$"

  # nvim pane 부터. `nvim .` 이라 oil 이 그 디렉터리를 바로 보여준다.
  if [ -n "$TMUX" ]; then
    pane=$(tmux new-window -P -F '#{pane_id}' -n "$dir_slug" -c "$PWD" \
             "CLAUDE_CONFIG_DIR=$qcd nvim .")
  else
    pane=$(tmux new-session -d -P -F '#{pane_id}' -s "$session" -c "$PWD" \
             "CLAUDE_CONFIG_DIR=$qcd nvim .")
  fi

  # 락이 뜨기를 최대 10초 기다린다. 못 찾으면 포트 없이(=--ide 에 맡기고) 진행.
  local port="" i
  for i in $(seq 1 40); do
    for f in "$config_dir"/ide/*.lock; do
      [ -e "$f" ] || continue
      case "$before" in *" $f "*) continue ;; esac
      port=$(basename -- "$f" .lock); break
    done
    [ -n "$port" ] && break
    sleep 0.25
  done

  local env_prefix="CLAUDE_CONFIG_DIR=$qcd ENABLE_IDE_INTEGRATION=true"
  [ -n "$port" ] && env_prefix="$env_prefix CLAUDE_CODE_SSE_PORT=$port"

  tmux split-window -h -l 40% -t "$pane" -c "$PWD" "$env_prefix command claude --ide $qargs"
  tmux select-pane -t "$pane"
  [ -z "$TMUX" ] && tmux attach -t "$session"
}

vcl()  { _claude_nvim_run "$HOME/.claude"         --dangerously-skip-permissions --effort xhigh "$@"; }
vclc() { _claude_nvim_run "$HOME/.claude-cubrid"  --dangerously-skip-permissions --effort xhigh "$@"; }
vclt() { _claude_nvim_run "$HOME/.cubrid-cubrid1" --dangerously-skip-permissions --effort xhigh "$@"; }

# 같은 계정으로 '격리된' 추가 세션 실행 (.claude.json 경합 없음 → 동시 실행 안전)
#   clm           → 개인 계정 격리 세션
#   clm cubrid    → 회사 계정 격리 세션
# 로그인(.credentials.json)만 공유하고, 세션별 임시 config 디렉토리를 쓴다.
# 종료되면 해당 임시 디렉토리는 자동 삭제된다(히스토리는 세션 간 비공유).
clm() {
  local base="$HOME/.claude"
  if [ "$1" = "cubrid" ] || [ "$1" = "clc" ]; then base="$HOME/.claude-cubrid"; shift; fi
  local sess="${base}-sessions/$$-${EPOCHSECONDS:-$(date +%s)}"
  mkdir -p "$sess"
  cp "$base/.credentials.json" "$sess/" 2>/dev/null   # 로그인 공유 → 같은 계정 인증
  cp "$base/.claude.json"      "$sess/" 2>/dev/null   # 시작 설정 시드(이후 독립)
  ( trap 'rm -rf "$sess"' EXIT
    CLAUDE_CONFIG_DIR="$sess" command claude "$@" )
}

# --- abtop: 항상 tmux 세션 안에서 실행 (added 2026-06-19) ---
# 이유: detach 상태로 계속 돌다가 `tmux attach -t abtop` 으로 언제든 다시 붙기 위함.
# - 이미 tmux 안($TMUX)이거나 stdout 이 TTY 가 아니면(파이프/비대화형) in-place 실행.
# - 아니면 'abtop' 이름의 tmux 세션에 붙거나(-A), 없으면 새로 만들어 실행한다.
#   (이미 떠 있으면 그 세션을 그대로 attach → 인자는 최초 생성 때만 적용됨)
# abtop-raw 는 tmux 없이 직접 실행하는 탈출구(raw).
alias abtop-raw='command abtop'
abtop() {
  if [ -n "$TMUX" ] || [ ! -t 1 ]; then
    command abtop "$@"
    return $?
  fi
  local args
  args=$(printf '%q ' "$@")
  tmux new-session -A -s abtop "command abtop $args"
}
