# CUBRID environment switcher
# Usage: use-cubrid [root_dir] [install_subdir]
#   root_dir      — root of the CUBRID source tree  (default: ~/cubrid)
#   install_subdir — install directory name inside root  (default: install.out)
# Examples:
#   use-cubrid                          → ~/cubrid/install.out
#   use-cubrid ~/cubrid-12              → ~/cubrid-12/install.out
#   use-cubrid ~/cubrid-12 build.out    → ~/cubrid-12/build.out
# Safe to call multiple times — strips previous CUBRID entries before setting new ones.
use-cubrid() {
  local cubrid_root="${1:-$HOME/cubrid}"
  local install_subdir="${2:-install.out}"
  local cubrid_path="$cubrid_root/$install_subdir"

  if [ ! -d "$cubrid_path" ]; then
    echo "Error: CUBRID install dir does not exist: $cubrid_path" >&2
    return 1
  fi

  # Strip any existing CUBRID entries from PATH and LD_LIBRARY_PATH
  # to prevent accumulation when switching between versions.
  # Uses -F (fixed-string) to avoid regex metacharacter issues in paths.
  if [ -n "${CUBRID:-}" ]; then
    PATH=$(echo "$PATH" | tr ':' '\n' | grep -Fv "$CUBRID" | paste -sd ':' || true)
    LD_LIBRARY_PATH=$(echo "${LD_LIBRARY_PATH:-}" | tr ':' '\n' | grep -Fv "$CUBRID" | paste -sd ':' || true)
    # Ensure we don't end up with an empty PATH which would expose CWD
    PATH="${PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}"
  fi

  export CUBRID="$cubrid_path"
  export CUBRID_DATABASES="$CUBRID/databases"
  export LD_LIBRARY_PATH="$CUBRID/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  export PATH="$CUBRID/bin:$PATH"
  echo "CUBRID environment set to: $CUBRID"
}

# --- Claude Code 계정 프로필 전환 (added 2026-06-01, 런타임 tmux → herdr 2026-09-22) ---
# 기본 계정(개인): ~/.claude          (hyunggyu.ryoo@gmail.com)
# cubrid 계정(회사): ~/.claude-cubrid  (hgryoo@cubrid.com)
# 테스트 계정:       ~/.cubrid-cubrid1
#
# 런타임은 herdr(https://herdr.dev) 다. tmux 와 모델이 다르다:
#   tmux  — 세션 하나에 claude 하나. 흩어진 세션을 나중에 cl-tabs 로 긁어모았다.
#   herdr — 워크스페이스 = (계정, 디렉터리), 그 안의 탭 = 개별 claude 세션.
#           사이드바가 모든 워크스페이스의 agent 상태(working/blocked/idle)를 상시로
#           굴려 보여주므로, cl-tabs / clc-tabs 가 뒤늦게 하던 일이 기본으로 붙는다.
#           detach 는 prefix+q (ctrl+b 는 tmux 와 같다), 복귀는 `herdr`.
#
# claude-main / claude-cubrid 는 herdr 없이 직접 실행하는 탈출구(raw)로 남겨둔다.
alias claude-main='CLAUDE_CONFIG_DIR=$HOME/.claude command claude'
alias claude-cubrid='CLAUDE_CONFIG_DIR=$HOME/.claude-cubrid command claude'

# 현재 경로 마지막 2개 컴포넌트를 워크스페이스 라벨용 슬러그로 변환한다.
_claude_dir_slug() {
  local dir_tail dir_slug
  dir_tail=$(printf %s "$PWD" | awk -F/ '{n=NF; a=(n>1?$(n-1):""); b=$n; print (a==""?b:a"-"b)}')
  dir_slug=$(printf %s "$dir_tail" | tr -c '[:alnum:]_-' '-' | sed 's/-\{2,\}/-/g; s/^-//; s/-$//')
  printf %s "${dir_slug:-root}"
}

# 계정 → 라벨 태그. 사이드바에서 어느 계정인지 한눈에 보이도록 라벨 앞에 붙는다.
# (tmux 시절의 claude- / claudec- 세션 이름 접두사가 하던 구분이다.)
_claude_tag() {
  case "$(basename -- "$1")" in
    .claude-cubrid)  printf clc ;;
    .cubrid-cubrid1) printf clt ;;
    *)               printf cl  ;;
  esac
}

# herdr pane 으로 보낼 명령줄의 인자를 안전하게 따옴표 친다.
# `printf '%q '` 는 인자가 하나도 없으면 빈 문자열을 '' 로 찍어 내는데, 그대로 명령줄에
# 붙이면 받는 쪽이 빈 인자를 하나 받는다 → 인자가 있을 때만 찍는다.
_herdr_qargs() { [ "$#" -gt 0 ] && printf '%q ' "$@"; }

# herdr 서버(백그라운드)가 떠 있도록 보장한다.
# workspace/pane 을 만드는 CLI 는 소켓이 있어야 동작하는데, 서버는 클라이언트가
# 붙어 있는지와 무관하게 산다 → attach 전에 먼저 띄워 두고 레이아웃을 만든다.
_herdr_up() {
  command -v herdr >/dev/null 2>&1 || {
    echo "herdr 가 설치돼 있지 않습니다: curl -fsSL https://herdr.dev/install.sh | sh" >&2
    return 1
  }
  herdr status server 2>/dev/null | grep -q '^status: running' && return 0

  # 서버는 오래 살고, 이 서버가 띄우는 모든 pane 이 그 환경을 물려받는다.
  # Claude Code 세션 안에서 cl 을 부르면(에이전트가 에이전트를 띄우는 자리) 부모의
  # CLAUDE_CODE_* 표식까지 통째로 상속돼, 새 pane 의 claude 가 스스로를 자식 세션으로
  # 알고 트랜스크립트 저장을 꺼 버린다. 계정(CLAUDE_CONFIG_DIR)도 pane 마다 --env 로
  # 따로 넣으므로, 서버만큼은 CLAUDE* 를 모두 턴 환경에서 띄운다.
  local -a strip=() ; local v
  while IFS='=' read -r v _; do
    case "$v" in CLAUDECODE|CLAUDE_*) strip+=( -u "$v" ) ;; esac
  done < <(env)

  if command -v setsid >/dev/null 2>&1; then
    setsid env "${strip[@]}" herdr server >/dev/null 2>&1 < /dev/null &
  else
    nohup env "${strip[@]}" herdr server >/dev/null 2>&1 < /dev/null &
  fi
  local i
  for i in $(seq 1 40); do
    herdr status server 2>/dev/null | grep -q '^status: running' && return 0
    sleep 0.25
  done
  echo "herdr 서버가 뜨지 않았습니다 — ~/.config/herdr/herdr-server.log 를 보세요" >&2
  return 1
}

# 라벨이 같은 워크스페이스의 id (없으면 빈 문자열).
_herdr_ws_id() {
  herdr workspace list 2>/dev/null \
    | jq -r --arg l "$1" '.result.workspaces[]? | select(.label == $l) | .workspace_id' \
    | head -1
}

# pane 이 놀고 있는가 — 포그라운드에 쉘 자신 말고는 아무것도 없는가.
_herdr_pane_idle() {
  herdr pane process-info --pane "$1" 2>/dev/null | jq -e '
    .result.process_info as $p
    | [$p.foreground_processes[]? | select(.pid != $p.shell_pid)] | length == 0
  ' >/dev/null
}

# (계정, 디렉터리) 자리를 잡고 그 안에 새 pane 을 하나 내준다 → pane id 를 찍는다.
# 같은 자리가 이미 있으면 워크스페이스를 재사용하고 탭만 하나 더 연다.
# 탭 이름은 herdr 기본값(1, 2, 3…)에 맡긴다 — 어느 계정의 어느 경로인지는 이미
# 워크스페이스 라벨이 들고 있고, 탭은 그 안에서 몇 번째 세션이냐만 구분하면 된다.
# 인자로 받은 --env 들은 그 pane 의 프로세스 환경으로 들어간다.
_herdr_claude_pane() {
  local label="$1"; shift
  local ws
  ws=$(_herdr_ws_id "$label")
  if [ -n "$ws" ]; then
    herdr tab create --workspace "$ws" --cwd "$PWD" "$@" --focus \
      | jq -r '.result.root_pane.pane_id // empty'
  else
    herdr workspace create --cwd "$PWD" --label "$label" "$@" --focus \
      | jq -r '.result.root_pane.pane_id // empty'
  fi
}

# 공통: Claude Code 를 herdr pane 안에서 실행하는 래퍼.
#   _claude_run <config_dir> [claude 인자...]
# - 이미 herdr pane 안($HERDR_ENV)이거나 stdout 이 TTY 가 아니면(파이프/비대화형) in-place 실행.
# - 아니면 (계정, 경로) 워크스페이스에 pane 을 하나 열어 거기서 띄우고 attach 한다.
_claude_run() {
  local config_dir="$1"; shift
  if [ "${HERDR_ENV:-}" = 1 ] || [ ! -t 1 ]; then
    CLAUDE_CONFIG_DIR="$config_dir" command claude "$@"
    return $?
  fi

  _herdr_up || return 1

  local slug tag pane
  slug=$(_claude_dir_slug)
  tag=$(_claude_tag "$config_dir")
  pane=$(_herdr_claude_pane "${tag}:${slug}" --env "CLAUDE_CONFIG_DIR=$config_dir")
  [ -n "$pane" ] || { echo "herdr: pane 을 만들지 못했습니다" >&2; return 1; }

  # `command claude` — 아래 claude() 래퍼를 건너뛰고 실제 바이너리를 부른다.
  herdr pane run "$pane" "command claude $(_herdr_qargs "$@")" >/dev/null
  herdr
}

# 짧은 진입점: cl → 개인 계정, clc → 회사(cubrid) 계정, clt → 테스트 계정.
cl() {
  # cl --incognito … → 격리 세션 (아래 _claude_incognito 주석 참고)
  if [ "$1" = "--incognito" ]; then shift; _claude_incognito "$@"; return $?; fi
  _claude_run "$HOME/.claude" --dangerously-skip-permissions --effort xhigh "$@"
}
clc() { _claude_run "$HOME/.claude-cubrid" --dangerously-skip-permissions --effort xhigh "$@"; }
clt() { _claude_run "$HOME/.cubrid-cubrid1" --dangerously-skip-permissions --effort xhigh "$@"; }

# `claude` 만 입력하면 개인(cl) / 회사(clc) 중 선택하도록 묻고, 역시 herdr pane 안에서 실행.
# 단, 계정이 이미 정해진 자리에서는 묻지 않는다: herdr 은 pane 에 CLAUDE_CONFIG_DIR 을
# 주입하므로, pane 안에서 `claude` 를 부르면 그 pane 의 계정을 그대로 쓴다.
# 프롬프트 없이 쓰려면 cl / clc / clt.
claude() {
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    command claude "$@"
    return $?
  fi
  local sel
  echo "어떤 Claude 계정으로 실행할까요?" >&2
  echo "  1) cl  → 개인 계정 (hyunggyu.ryoo@gmail.com)  [~/.claude]" >&2
  echo "  2) clc → 회사 계정 (hgryoo@cubrid.com)        [~/.claude-cubrid]" >&2
  read -r -p "선택 [1/2] (기본 1): " sel
  case "$sel" in
    2|clc|c) _claude_run "$HOME/.claude-cubrid" "$@" ;;
    *)       _claude_run "$HOME/.claude"        "$@" ;;
  esac
}

# --- incognito 세션 (added 2026-09-18) ---
#   cl --incognito [claude 인자...]
#
# ~/.claude-incognito 아래에 1회용 설정 디렉토리를 만들어 그 안에서만 실행한다.
#
# 남지 않는 것 — 종료 시 해당 디렉토리를 통째로 삭제:
#   대화 기록(projects/*.jsonl, history.jsonl), 세션/통계, todos, shell-snapshots,
#   그리고 TMPDIR 도 이 디렉토리 밑으로 돌리므로 스크래치패드 잔여물까지 함께 사라진다.
# 읽지 않는 것:
#   --safe-mode            → CLAUDE.md(사용자/프로젝트), 스킬, 플러그인, 훅(snip 포함),
#                            MCP, 커스텀 에이전트/커맨드/출력스타일/테마/키바인딩 전부 비활성
#   --setting-sources user → 프로젝트 .claude/settings.json / settings.local.json 무시
#   --strict-mcp-config    → 프로젝트 .mcp.json 무시
# 기억하지 않는 것:
#   autoMemoryEnabled=false → 자동 메모리 기록 off
# 물려받는 것:
#   ~/.claude 의 로그인(.credentials.json) 뿐. 그 외 상태는 아무것도 상속하지 않는다.
_claude_incognito() {
  local root="$HOME/.claude-incognito"
  mkdir -p "$root" || return 1
  chmod 700 "$root"

  # 비정상 종료(SIGKILL, pane 강제 종료)로 남은 이전 잔여물 청소:
  # 디렉토리 이름의 PID 가 이미 죽었으면 삭제한다.
  local d pid
  for d in "$root"/*-*; do
    [ -d "$d" ] || continue
    pid=${d##*/}; pid=${pid%%-*}
    kill -0 "$pid" 2>/dev/null || rm -rf "$d"
  done

  local sess="$root/$$-${EPOCHSECONDS:-$(date +%s)}"
  mkdir -p "$sess/tmp" || return 1
  chmod 700 "$sess"
  cp "$HOME/.claude/.credentials.json" "$sess/" 2>/dev/null   # 로그인만 공유

  # 온보딩/신뢰 대화상자만 건너뛰는 최소 시드. 대화·프로젝트 기록은 시드하지 않는다.
  _CL_INC_PWD="$PWD" python3 -c 'import json,os,sys; json.dump({"hasCompletedOnboarding":True,"installMethod":"native","autoUpdates":False,"projects":{os.environ["_CL_INC_PWD"]:{"hasTrustDialogAccepted":True,"hasClaudeMdExternalIncludesApproved":True}}}, open(sys.argv[1],"w"))' "$sess/.claude.json"

  local -a opts=(
    --safe-mode
    --setting-sources user
    --strict-mcp-config
    --settings '{"autoMemoryEnabled":false,"skipDangerousModePermissionPrompt":true}'
    --dangerously-skip-permissions
    --effort xhigh
  )

  if [ "${HERDR_ENV:-}" = 1 ] || [ ! -t 1 ]; then
    ( trap 'rm -rf "$sess"' EXIT
      export CLAUDE_CONFIG_DIR="$sess" TMPDIR="$sess/tmp" \
             DISABLE_TELEMETRY=1 DISABLE_ERROR_REPORTING=1 \
             CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
      command claude "${opts[@]}" "$@" )
    return $?
  fi

  _herdr_up || { rm -rf "$sess"; return 1; }

  # 격리 세션은 재사용할 자리가 없다 → 매번 제 워크스페이스를 판다.
  local pane
  pane=$(herdr workspace create --cwd "$PWD" --label "cli:$(_claude_dir_slug)" \
           --env "CLAUDE_CONFIG_DIR=$sess" --env "TMPDIR=$sess/tmp" \
           --env DISABLE_TELEMETRY=1 --env DISABLE_ERROR_REPORTING=1 \
           --env CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 --focus \
         | jq -r '.result.root_pane.pane_id // empty')
  [ -n "$pane" ] || { echo "herdr: pane 을 만들지 못했습니다" >&2; rm -rf "$sess"; return 1; }

  # 정리를 pane 안에서 끝낸다 → detach 해도 살아있는 세션의 디렉토리가 지워지지 않는다.
  herdr pane run "$pane" \
    "command claude $(_herdr_qargs "${opts[@]}" "$@"); rm -rf $(printf %q "$sess")" >/dev/null
  herdr
}

# --- nvim + Claude 를 한 화면에 (added 2026-09-21) ---
# vcl / vclc / vclt : cl / clc / clt 와 같은 계정으로, 현재 경로에서 nvim(왼쪽)과
# claude(오른쪽)를 한 탭의 두 pane 으로 띄운다. 인자는 claude 로 넘어간다.
#
# 핵심은 두 pane 이 서로 붙는다는 것이다. claudecode.nvim 은
# $CLAUDE_CONFIG_DIR/ide/<port>.lock 에 락을 쓰므로, nvim pane 에도 같은 계정을 주고
# 새로 생긴 락에서 포트를 읽어 claude pane 에 CLAUDE_CODE_SSE_PORT 로 넘긴다.
# --ide 만 쓰면 "정확히 하나"일 때만 자동 연결이라, 에디터를 여러 개 띄워 두면 실패한다.
#
# 라벨은 _claude_run 과 같은 규칙(cl: / clc: / clt:)이라 같은 (계정, 경로) 워크스페이스에
# 탭으로 모인다.
_claude_nvim_run() {
  local config_dir="$1"; shift
  _herdr_up || return 1

  # 이 nvim 이 새로 만드는 락만 골라내기 위해 먼저 스냅샷.
  local before=" " f
  for f in "$config_dir"/ide/*.lock; do [ -e "$f" ] && before="$before$f "; done

  # 왼쪽 pane = nvim. `nvim .` 이라 oil 이 그 디렉터리를 바로 보여준다.
  local slug tag left
  slug=$(_claude_dir_slug)
  tag=$(_claude_tag "$config_dir")
  left=$(_herdr_claude_pane "${tag}:${slug}" --env "CLAUDE_CONFIG_DIR=$config_dir")
  [ -n "$left" ] || { echo "herdr: nvim pane 을 만들지 못했습니다" >&2; return 1; }
  herdr pane run "$left" 'nvim .' >/dev/null

  # 락이 뜨기를 최대 10초 기다린다. 못 찾으면 포트 없이(=--ide 에 맡기고) 진행.
  local port="" i
  for i in $(seq 1 40); do
    for f in "$config_dir"/ide/*.lock; do
      [ -e "$f" ] || continue
      case "$before" in *" $f "*) continue ;; esac
      port=$(basename -- "$f" .lock); break
    done
    [ -n "$port" ] && break
    sleep 0.25
  done

  # 오른쪽 40% = claude. herdr 의 --ratio 는 '쪼개진 원래 pane' 의 몫이라 0.6 이 왼쪽 60%.
  local -a envs=( --env "CLAUDE_CONFIG_DIR=$config_dir" --env ENABLE_IDE_INTEGRATION=true )
  [ -n "$port" ] && envs+=( --env "CLAUDE_CODE_SSE_PORT=$port" )

  local right
  right=$(herdr pane split --pane "$left" --direction right --ratio 0.6 --cwd "$PWD" \
            "${envs[@]}" --no-focus | jq -r '.result.pane.pane_id // empty')
  [ -n "$right" ] || { echo "herdr: claude pane 을 만들지 못했습니다" >&2; return 1; }
  herdr pane run "$right" "command claude --ide $(_herdr_qargs "$@")" >/dev/null

  # 이미 herdr 안이면 레이아웃만 만들고 끝낸다 — herdr 은 중첩 실행을 막는다.
  [ "${HERDR_ENV:-}" = 1 ] || herdr
}

vcl()  { _claude_nvim_run "$HOME/.claude"         --dangerously-skip-permissions --effort xhigh "$@"; }
vclc() { _claude_nvim_run "$HOME/.claude-cubrid"  --dangerously-skip-permissions --effort xhigh "$@"; }
vclt() { _claude_nvim_run "$HOME/.cubrid-cubrid1" --dangerously-skip-permissions --effort xhigh "$@"; }

# 같은 계정으로 '격리된' 추가 세션 실행 (.claude.json 경합 없음 → 동시 실행 안전)
#   clm           → 개인 계정 격리 세션
#   clm cubrid    → 회사 계정 격리 세션
# 로그인(.credentials.json)만 공유하고, 세션별 임시 config 디렉토리를 쓴다.
# 종료되면 해당 임시 디렉토리는 자동 삭제된다(히스토리는 세션 간 비공유).
clm() {
  local base="$HOME/.claude"
  if [ "$1" = "cubrid" ] || [ "$1" = "clc" ]; then base="$HOME/.claude-cubrid"; shift; fi
  local sess="${base}-sessions/$$-${EPOCHSECONDS:-$(date +%s)}"
  mkdir -p "$sess"
  cp "$base/.credentials.json" "$sess/" 2>/dev/null   # 로그인 공유 → 같은 계정 인증
  cp "$base/.claude.json"      "$sess/" 2>/dev/null   # 시작 설정 시드(이후 독립)
  ( trap 'rm -rf "$sess"' EXIT
    CLAUDE_CONFIG_DIR="$sess" command claude "$@" )
}

# --- abtop: 항상 herdr 워크스페이스 안에서 실행 (added 2026-06-19, tmux → herdr 2026-09-22) ---
# 이유는 tmux 때와 같다: detach 한 채로 계속 돌다가 언제든 다시 붙기 위함.
# 자리는 하나뿐이다 — tmux 의 `new-session -A -s abtop` 이 그랬듯 'abtop' 워크스페이스가
# 이미 있으면 새로 만들지 않고 포커스만 옮긴다 (인자는 최초 생성 때만 적용된다).
# cl / clc 와 달리 탭을 더 쌓지 않는다: abtop 은 여러 벌 띄울 이유가 없다.
#
# tmux 와 한 군데 다르다. abtop 이 끝나면 tmux 는 세션째 사라져 다음 호출이 새로 띄웠지만,
# herdr 은 pane 이 쉘 프롬프트로 돌아올 뿐 워크스페이스가 남는다. 그래서 자리를 재사용할
# 때 그 pane 이 놀고 있으면 abtop 을 다시 띄운다 — 빈 쉘만 비추고 끝나지 않도록.
# 무언가 다른 게 돌고 있으면 건드리지 않고 포커스만 옮긴다.
#
# - 이미 herdr pane 안($HERDR_ENV)이거나 stdout 이 TTY 가 아니면(파이프/비대화형) in-place 실행.
# abtop-raw 는 herdr 없이 직접 실행하는 탈출구(raw).
alias abtop-raw='command abtop'
abtop() {
  if [ "${HERDR_ENV:-}" = 1 ] || [ ! -t 1 ]; then
    command abtop "$@"
    return $?
  fi

  _herdr_up || return 1

  local ws pane
  ws=$(_herdr_ws_id abtop)
  if [ -n "$ws" ]; then
    pane=$(herdr pane list --workspace "$ws" 2>/dev/null \
           | jq -r '.result.panes[0].pane_id // empty')
    if [ -n "$pane" ] && _herdr_pane_idle "$pane"; then
      herdr pane run "$pane" "command abtop $(_herdr_qargs "$@")" >/dev/null
    fi
    herdr workspace focus "$ws" >/dev/null
  else
    pane=$(herdr workspace create --cwd "$PWD" --label abtop --focus \
           | jq -r '.result.root_pane.pane_id // empty')
    [ -n "$pane" ] || { echo "herdr: pane 을 만들지 못했습니다" >&2; return 1; }
    herdr pane run "$pane" "command abtop $(_herdr_qargs "$@")" >/dev/null
  fi
  herdr
}
