# Load oh-my-bash
export OSH="$HOME/.oh-my-bash"
if [ -f "$OSH/oh-my-bash.sh" ]; then
  source "$OSH/oh-my-bash.sh"
fi

# Load custom configs
[ -f ~/.bash_aliases ] && source ~/.bash_aliases
[ -f ~/.bash_exports ] && source ~/.bash_exports

# Rust
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# uv (Python package manager)
if command -v uv &>/dev/null; then
  eval "$(uv generate-shell-completion bash)"
fi

{{ if stat (joinPath .chezmoi.homeDir ".pyenv" "bin" "pyenv") -}}
# pyenv backward-compat: remove once fully migrated to uv
export PATH="$HOME/.pyenv/bin:$PATH"
eval "$(pyenv init -)"

{{ end -}}
# nvm + Node (agent tooling: codex, openclaw, sisyphus; slides: marp, mermaid)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# direnv
if command -v direnv &>/dev/null; then
  eval "$(direnv hook bash)"
fi

# fzf
if command -v fzf &>/dev/null; then
  # fzf 0.48+ supports --bash; older versions use separate scripts
  if fzf --bash &>/dev/null; then
    eval "$(fzf --bash)"
  elif [ -f /usr/share/doc/fzf/examples/key-bindings.bash ]; then
    source /usr/share/doc/fzf/examples/key-bindings.bash
  fi
fi

# ~/bin on PATH — must stay ahead of /usr/bin so CUBRID picks up bison 3.0.5
export PATH="$HOME/bin:$PATH"

# uv tools / chezmoi / snip live here
export PATH="$HOME/.local/bin:$PATH"

# Secrets (API keys, VPN + server credentials) — git-ignored, see
# dotfiles/secrets.env.template. Sourced so connect_* helpers can read them.
[ -f "$HOME/.secrets.env" ] && . "$HOME/.secrets.env"

export ENABLE_LSP_TOOL=1

# Editor defaults
export EDITOR="vim"
