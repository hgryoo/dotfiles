{
  "autoMemoryEnabled": false,
  "effortLevel": "high",
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/home/hgryoo/.local/bin/snip hook",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
