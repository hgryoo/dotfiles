#!/usr/bin/env bash
# Add the extensionless names the ~/bin scripts are typed with: `connect-ts`,
# not `connect-ts.sh`. chezmoi deploys bin/ as real files; this adds the links.
#
# The list below makes chezmoi re-run this script whenever a script is added to
# or removed from bin/. A plain run_after_ would also do that, but chezmoi status
# would then report it as pending forever.
#
# bin/: {{ range glob (joinPath .chezmoi.sourceDir "bin" "*") }}{{ base . }} {{ end }}
#
# Anything already sitting at an alias name, a dangling link included, is left
# alone.

set -eu

[ -d "$HOME/bin" ] || exit 0

link() {  # link <alias> <target-in-~/bin>
  if [ -e "$HOME/bin/$1" ] || [ -L "$HOME/bin/$1" ]; then
    return 0
  fi
  ln -s "$2" "$HOME/bin/$1"
  echo ">>> ~/bin/$1 -> $2"
}

for f in "$HOME"/bin/*.sh; do
  [ -f "$f" ] || continue
  base="$(basename "$f")"
  link "${base%.sh}" "$base"
done

# cl-tabs also answers to clc-tabs (the claude-cubrid config dir variant).
[ -f "$HOME/bin/cl-tabs.sh" ] && link clc-tabs cl-tabs.sh
exit 0
