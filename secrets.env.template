# secrets.env.template — Copy to secrets.env and fill in values.
# secrets.env is git-ignored and never committed.
#
# Usage:
#   cp secrets.env.template secrets.env
#   $EDITOR secrets.env
#   bash auth.sh

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# GitHub
# ---------------------------------------------------------------------------
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# HuggingFace
# ---------------------------------------------------------------------------
HUGGINGFACE_TOKEN=

# ---------------------------------------------------------------------------
# JIRA (CUBRID)
# ---------------------------------------------------------------------------
JIRA_URL=http://jira.cubrid.org
JIRA_USERNAME=
JIRA_PASSWORD=

# ---------------------------------------------------------------------------
# Google Workspace (gws)
# OAuth credentials from Google Cloud Console.
# Run: gws auth setup   (to create a Cloud project)
# Then: gws auth login  (to authorize)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Open Notebook (self-hosted NotebookLM alternative)
# Used by ~/open-notebook/docker-compose.yml via .env symlink.
# install_kb.sh auto-generates a random hex key if this is missing.
# ---------------------------------------------------------------------------
OPEN_NOTEBOOK_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# CUBRID VPN (openfortivpn) — bin/connect-vpn.sh
# CUBRID_VPN_CERT is the --trusted-cert fingerprint the gateway presents.
# Leave CUBRID_VPN_PASSWORD blank to be prompted on every connect.
# ---------------------------------------------------------------------------
CUBRID_VPN_GATEWAY=
CUBRID_VPN_USERNAME=
CUBRID_VPN_CERT=
CUBRID_VPN_PASSWORD=

# ---------------------------------------------------------------------------
# Remote hosts — bin/connect-aws.sh, bin/connect-perf.sh
# CUBVEC_EC2_KEY defaults to ~/cubvec_keypair1.pem; the key file itself is not
# in this repo — copy it from the previous machine and chmod 400 it.
# ---------------------------------------------------------------------------
CUBVEC_EC2_HOST=
CUBVEC_EC2_KEY=
PERF_HOST=
PERF_PASSWORD=
